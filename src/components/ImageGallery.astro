---
import { withBase } from '../lib/posts';

interface GalleryImage {
  src: string;
  index: number;
}

interface Props {
  images: GalleryImage[];
  title: string;
}

const { images, title } = Astro.props;
---

<section class="gallery" aria-label="帖子图片">
  {
    images.map(({ src, index }) => (
      <figure class="gallery__item">
        <img
          src={withBase(src)}
          alt={`${title} · 图片 ${index + 1}`}
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))
  }
</section>
