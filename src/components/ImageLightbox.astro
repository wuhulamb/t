---
---

<dialog id="image-lightbox" class="lightbox" aria-label="图片预览">
  <button
    type="button"
    class="lightbox__close"
    data-lightbox-close
    aria-label="关闭图片预览"
  >
    ×
  </button>
  <button
    type="button"
    class="lightbox__nav lightbox__prev"
    data-lightbox-prev
    aria-label="上一张图片"
  >
    ‹
  </button>
  <figure class="lightbox__figure">
    <img class="lightbox__image" data-lightbox-image alt="" />
    <figcaption class="lightbox__caption">
      <span data-lightbox-counter aria-live="polite"></span>
      <span data-lightbox-caption></span>
    </figcaption>
  </figure>
  <button
    type="button"
    class="lightbox__nav lightbox__next"
    data-lightbox-next
    aria-label="下一张图片"
  >
    ›
  </button>
</dialog>

<script>
  const dialog = document.getElementById('image-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
    const prevButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;

    let images: HTMLImageElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const postImages = (): HTMLImageElement[] =>
      Array.from(document.querySelectorAll<HTMLImageElement>('.post img')).filter(
        (item) => item.closest('.lightbox') === null,
      );

    const update = () => {
      const current = images[index];
      if (!current) return;

      image.src = current.currentSrc || current.src;
      image.alt = current.alt || '';
      counter.textContent = `${index + 1} / ${images.length}`;
      caption.textContent = current.alt || '';

      const multiple = images.length > 1;
      prevButton.hidden = !multiple;
      nextButton.hidden = !multiple;
    };

    const open = (target: HTMLImageElement) => {
      images = postImages();
      index = images.indexOf(target);
      if (index < 0) {
        images = [target];
        index = 0;
      }

      opener = document.activeElement as HTMLElement | null;
      update();
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add('lightbox-open');
      closeButton.focus();
    };

    const close = () => {
      if (!dialog.open) return;
      document.documentElement.classList.remove('lightbox-open');
      dialog.close();
    };

    const step = (delta: number) => {
      if (images.length < 2) return;
      index = (index + delta + images.length) % images.length;
      update();
    };

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }
      const target =
        event.target instanceof Element
          ? event.target.closest<HTMLImageElement>('.post img')
          : null;
      if (!target) return;

      event.preventDefault();
      open(target);
    });

    closeButton.addEventListener('click', close);
    prevButton.addEventListener('click', () => step(-1));
    nextButton.addEventListener('click', () => step(1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('lightbox-open');
      image.removeAttribute('src');
      if (opener && typeof opener.focus === 'function') opener.focus();
      opener = null;
    });
  }
</script>
