---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../config';
import { getPublishedPosts } from '../lib/content';
import { formatDate, toDateISO, withBase } from '../lib/posts';

const posts = await getPublishedPosts();
const latest = posts[0];
---

<BaseLayout>
  <section class="hero">
    <div class="hero__copy">
      <h1>{siteConfig.title}</h1>
      <p class="hero__lede">{siteConfig.description}</p>
    </div>
    <aside class="hero__aside" aria-label="站点统计">
      <div class="hero__stats">
        <div class="stat">
          <strong>{posts.length}</strong>
          <span>篇记录</span>
        </div>
      </div>
      {
        latest && (
          <p class="hero__latest">
            最近更新<br />
            <time datetime={toDateISO(latest.data.createdAt)}>
              {formatDate(latest.data.createdAt)}
            </time>
          </p>
        )
      }
    </aside>
  </section>

  <section aria-labelledby="latest-posts">
    <div class="section-heading">
      <h2 id="latest-posts">最近</h2>
      {posts.length > 0 && <a class="text-link" href={withBase('/posts/')}>全部归档 →</a>}
    </div>

    {
      posts.length === 0 ? (
        <div class="empty-state">
          <p class="empty-state__title">还没有帖子。</p>
          <p>新的记录会出现在这里。</p>
        </div>
      ) : (
        <div class="post-list">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )
    }
  </section>
</BaseLayout>
