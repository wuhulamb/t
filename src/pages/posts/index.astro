---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/content';
import type { Post } from '../../lib/content';
import {
  formatMonthDay,
  getPostTitle,
  getYear,
  postPath,
  withBase,
} from '../../lib/posts';
import { countCharacters } from '../../lib/text';

const posts = await getPublishedPosts();
const groups: { year: string; posts: Post[] }[] = [];

for (const post of posts) {
  const year = getYear(post.data.createdAt);
  const current = groups.at(-1);
  if (current?.year === year) {
    current.posts.push(post);
  } else {
    groups.push({ year, posts: [post] });
  }
}
---

<BaseLayout title="归档" description="按时间浏览全部帖子。">
  <header class="page-header">
    <h1>全部归档</h1>
    <p class="page-header__lede">
      共 {posts.length} 篇记录。
    </p>
  </header>

  {
    groups.length === 0 ? (
      <div class="empty-state">
        <p class="empty-state__title">归档还是空的。</p>
        <p>添加第一篇帖子后，这里会自动出现记录。</p>
      </div>
    ) : (
      <div class="archive">
        {groups.map((group) => (
          <section class="archive-year" aria-labelledby={`year-${group.year}`}>
            <h2 id={`year-${group.year}`}>{group.year}</h2>
            <ul class="archive-list">
              {group.posts.map((post) => (
                <li>
                  <a class="archive-item" href={withBase(postPath(post.id))}>
                    <time datetime={post.data.createdAt.toISOString()}>
                      {formatMonthDay(post.data.createdAt)}
                    </time>
                    <span class="archive-item__title">{getPostTitle(post)}</span>
                    <span class="archive-item__meta">
                      {countCharacters(post.body ?? '')} 字
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
